# --- Database ---
# Local docker-compose uses these credentials; change for production.
DATABASE_URL="postgresql://kb:kb_password@localhost:5432/knowledgebase?schema=public"

# --- Auth ---
# Generate a strong secret, e.g.  openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# --- AI (mock interview) ---
# Key from https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-..."
# Model to use for the interviewer + scoring. Override if your account uses a
# different model name.
ANTHROPIC_MODEL="claude-sonnet-5"

# --- Server ---
PORT=3001
# Comma-separated list of allowed frontend origins, or * for any.
CORS_ORIGIN="http://localhost:5173"
